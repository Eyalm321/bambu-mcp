# Bambu Lab printer, LAN mode (printer screen: Settings > LAN Mode)
BAMBU_IP=192.168.1.42
BAMBU_ACCESS_CODE=your_lan_access_code
BAMBU_SERIAL=01P00A1234567890
# bambu-js schema: P1S or H2D (case-insensitive). P2S uses the P1S dialect.
BAMBU_MODEL=P1S
# Slicer binary for the bambu_slice tool (auto-detected if unset)
# SLICER_BIN=/home/you/Applications/BambuStudio.AppImage
